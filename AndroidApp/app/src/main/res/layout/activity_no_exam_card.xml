<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A2E"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:paddingEnd="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Exam Card"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvVenueHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#AAAACC"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>

        </LinearLayout>
    </LinearLayout>

    <!-- Student ID input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/etStudentId"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="Enter student ID e.g. 2026001"
            android:inputType="number"
            android:textSize="15sp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnFindStudent"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Find Student"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#1A73E8"
            style="@style/Widget.MaterialComponents.Button"/>

    </LinearLayout>

    <!-- Student result card same as scan result -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardStudentInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Student name and image row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <!-- Left: name ID and program -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvStudentName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A2E"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:id="@+id/tvStudentId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="12sp"
                                android:textColor="#888888"
                                android:layout_marginBottom="4dp"/>

                            <TextView
                                android:id="@+id/tvStudentProgram"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="12sp"
                                android:textColor="#888888"/>

                        </LinearLayout>

                        <!-- Right: student photo square -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_marginStart="12dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="4dp">

                            <ImageView
                                android:id="@+id/imgStudent"
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:src="@drawable/ic_launcher_foreground"
                                android:scaleType="fitCenter"
                                android:adjustViewBounds="true"
                                android:background="#F0F4F8"/>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginBottom="12dp"/>

                    <!-- Course -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Course"
                            android:textSize="13sp"
                            android:textColor="#888888"/>

                        <TextView
                            android:id="@+id/tvCourseName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text=""
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E"/>

                    </LinearLayout>

                    <!-- Seat -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Seat"
                            android:textSize="13sp"
                            android:textColor="#888888"/>

                        <TextView
                            android:id="@+id/tvSeatNumber"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text=""
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E"/>

                    </LinearLayout>

                    <!-- Venue -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Venue"
                            android:textSize="13sp"
                            android:textColor="#888888"/>

                        <TextView
                            android:id="@+id/tvVenue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text=""
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E"/>

                    </LinearLayout>

                    <!-- Exam Date -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Exam Date"
                            android:textSize="13sp"
                            android:textColor="#888888"/>

                        <TextView
                            android:id="@+id/tvExamDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text=""
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E"/>

                    </LinearLayout>

                    <!-- Exam Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Time"
                            android:textSize="13sp"
                            android:textColor="#888888"/>

                        <TextView
                            android:id="@+id/tvExamTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:text=""
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E"/>

                    </LinearLayout>

                    <!-- Venue status -->
                    <TextView
                        android:id="@+id/tvVenueStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:padding="10dp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Process Button -->
                    <Button
                        android:id="@+id/btnMarkWritten"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Process"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:backgroundTint="#1A1A2E"
                        style="@style/Widget.MaterialComponents.Button"/>

                    <!-- Find Next Student Button -->
                    <Button
                        android:id="@+id/btnFindNext"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Find Next Student"
                        android:textColor="#1A73E8"
                        android:textSize="14sp"
                        android:backgroundTint="#E8F4FD"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.MaterialComponents.Button"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>